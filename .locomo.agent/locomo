        "upgrade": cmd_upgrade,
        "rollback": cmd_rollback,
        "graphify": cmd_graphify,
        "store": cmd_store,
        "read": cmd_read,
        "update": cmd_update,
        "think": cmd_think,
        "select": cmd_select,
        "config": cmd_config,
        "validate": cmd_validate,
        "status": cmd_status,
        "bootcheck": cmd_bootcheck
    }

    commands[args.command](args)

if __name__ == "__main__":
