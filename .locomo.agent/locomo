# Perintah CLI
# Validasi cortex lanjutan (Tiket 2.4): satu fungsi dipakai bootcheck, `validate`,
# dan `config set` (rollback bila error). Error = struktur rusak; warning = nilai
# legacy di luar enum (contoh: phase/strategy free-text lama) — dilaporkan, tak diblokir.
CORTEX_REQUIRED = ("current_phase", "system_health", "tasks", "priorities")
CORTEX_PHASES = {"THINK", "SYNC", "ACT", "REFLECT", "IDLE"}
CORTEX_HEALTH = {"healthy", "degraded", "critical"}
CORTEX_TASK_STATUS = {"PENDING", "IN_PROGRESS", "COMPLETED", "BLOCKED"}

def validate_cortex(anti_dir):
    errors, warnings = [], []
    cortex_path = os.path.join(anti_dir, "cortex", "cortex-core.json")
    try:
        with open(cortex_path, "r", encoding="utf-8") as f:
            cortex = json.load(f)
    except Exception as e:
        return [f"cortex-core.json tidak bisa dibaca: {e}"], []
    for field in CORTEX_REQUIRED:
        if field not in cortex:
            errors.append(f"field wajib '{field}' hilang")
    health = cortex.get("system_health", "")
    if "system_health" in cortex and health not in CORTEX_HEALTH:
        errors.append(f"system_health '{health}' di luar {sorted(CORTEX_HEALTH)}")
    phase = cortex.get("current_phase", "")
    if "current_phase" in cortex and phase not in CORTEX_PHASES:
        warnings.append(f"current_phase '{phase}' di luar enum {sorted(CORTEX_PHASES)} (nilai legacy?)")
    tasks = cortex.get("tasks", None)
    if tasks is not None:
        if not isinstance(tasks, list):
            errors.append("'tasks' bukan list")
        else:
            seen = set()
            for i, t in enumerate(tasks):
                if not isinstance(t, dict):
                    errors.append(f"tasks[{i}] bukan objek"); continue
                for f in ("id", "status", "label"):
                    if f not in t:
                        errors.append(f"tasks[{i}] kehilangan '{f}'")
                if t.get("status") not in CORTEX_TASK_STATUS:
                    errors.append(f"tasks[{i}] status '{t.get('status')}' di luar {sorted(CORTEX_TASK_STATUS)}")
                if t.get("id") in seen:
                    warnings.append(f"tasks[{i}] id duplikat '{t.get('id')}'")
                seen.add(t.get("id"))
    prio = cortex.get("priorities", None)
    if prio is not None:
        if not isinstance(prio, list):
            errors.append("'priorities' bukan list")
        elif not prio:
            warnings.append("'priorities' kosong — orkestrator tak punya skor tertinggi")
        elif any(not isinstance(p, str) for p in prio):
            errors.append("'priorities' harus list string")
    strat = cortex.get("active_strategy", "")
    if strat:
        try:
            with open(os.path.join(anti_dir, "cortex", "strategies.json")) as f:
                ids = {s["id"] for s in json.load(f).get("strategies", [])}
            if strat not in ids:
                warnings.append(f"active_strategy '{strat}' tak ada di strategies.json (nilai legacy?)")
        except Exception:
            pass
    if health == "critical":
        errors.append("system_health=critical — hentikan eksekusi (Authorization Gate)")
    return errors, warnings

def cmd_validate(args):
    anti_dir = resolve_os_dir(require=True)
    errors, warnings = validate_cortex(anti_dir)
    for w in warnings:
        print(f"[VALIDATE] PERINGATAN: {w}")
    if errors:
        for e in errors:
            print(f"[VALIDATE] ERROR: {e}")
        sys.exit(1)
    print("[VALIDATE] OK." + (f" ({len(warnings)} peringatan)" if warnings else ""))

def _post_json(url, data, timeout=25):
    try:
        req = urllib.request.Request(url, data=json.dumps(data).encode('utf-8'), method='POST')
        req.add_header('Content-Type', 'application/json')
        with urllib.request.urlopen(req, data=req.data, timeout=timeout) as response:
            return json.loads(response.read().decode('utf-8'))
    except Exception:
        return None

