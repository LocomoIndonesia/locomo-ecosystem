    p_bootcheck.add_argument("--yes", action="store_true", help="Daftarkan project bila belum terdaftar (persetujuan eksplisit)")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    commands = {
