def _config_load(anti_dir, spec):
    path = os.path.join(anti_dir, spec["file"])
    with open(path, 'r') as f:
        return json.load(f), path

def cmd_config(args):
    anti_dir = resolve_os_dir(require=True)
    action = args.action
    if action == "list":
        for key in sorted(CONFIG_KEYS):
            spec = CONFIG_KEYS[key]
            try:
                data, _ = _config_load(anti_dir, spec)
                print(f"{key} = {data.get(spec['field'])} {'(read-only)' if not spec['writable'] else ''}")
            except Exception as e:
                print(f"{key} = <error: {e}>")
        return
    if args.key not in CONFIG_KEYS:
        print(f"Error: kunci '{args.key}' tidak dikenal. Kunci valid: {', '.join(sorted(CONFIG_KEYS))}")
        sys.exit(1)
    spec = CONFIG_KEYS[args.key]
    if action == "get":
        data, _ = _config_load(anti_dir, spec)
        print(f"{args.key} = {data.get(spec['field'])}")
        return
    # action == "set"
    if args.value is None:
        print(f"Error: aksi set butuh nilai. Contoh: locomo config set {args.key} <value>")
        sys.exit(1)
    if not spec["writable"]:
        print(f"Error: '{args.key}' read-only. {spec.get('hint', '')}")
        sys.exit(1)
    value = args.value
    allowed = set(spec.get("enum", set()))
    if spec.get("enum_from"):
        try:
            with open(os.path.join(anti_dir, spec["enum_from"])) as f:
                allowed = {s["id"] for s in json.load(f).get("strategies", [])}
        except Exception as e:
            print(f"Error: tidak bisa memuat {spec['enum_from']}: {e}")
            sys.exit(1)
    if allowed and value not in allowed:
        print(f"Error: '{value}' tidak valid untuk {args.key}. Valid: {sorted(allowed)}")
        sys.exit(1)
    data, path = _config_load(anti_dir, spec)
    old = data.get(spec["field"])
    data[spec["field"]] = value
    with open(path, 'w') as f:
        json.dump(data, f, indent=2)
    # Tiket 2.4: validasi pasca-tulis; error = rollback agar cortex tak rusak.
    errors, warnings = validate_cortex(anti_dir)
    if errors:
        data[spec["field"]] = old
        with open(path, 'w') as f:
            json.dump(data, f, indent=2)
        print(f"Error: nilai '{value}' merusak konsistensi cortex — perubahan dibatalkan:")
        for e in errors:
            print(f"  - {e}")
        sys.exit(1)
    for w in warnings:
        print(f"PERINGATAN: {w}")
    print(f"{args.key} = {value} (tersimpan di {spec['file']})")

