def safe_resolve(path):
    if os.path.isabs(path):
        parts = []
        drive, path = os.path.splitdrive(path)
        while True:
            path, folder = os.path.split(path)
            if folder:
                parts.append(folder)
            else:
                if path:
                    parts.append(path)
                break
        parts.reverse()
        clean_parts = [p.replace('/', '').replace('\\', '') for p in parts if p not in ('', '/', '\\')]
        path = os.path.join(*clean_parts) if clean_parts else "."
        
    resolved = os.path.abspath(path)
    cwd = os.getcwd()
    if not resolved.startswith(cwd):
        raise PermissionError(f"Access denied: Path '{path}' is outside the workspace.")
    return resolved

# Tool Functions untuk Offline Reasoning Agent
def tool_read_file(args):
    path = args.get("path")
    if not path:
        return {"status": "error", "message": "Missing 'path' argument."}
    try:
        safe_path = safe_resolve(path)
        with open(safe_path, 'r', encoding='utf-8') as f:
            return {"status": "success", "content": f.read()}
    except Exception as e:
        return {"status": "error", "message": str(e)}

def tool_write_file(args):
    path = args.get("path")
    content = args.get("content")
    if not path or content is None:
        return {"status": "error", "message": "Missing 'path' or 'content' arguments."}
    
    res = run_in_docker(["write", "--path", path, "--content", content])
    if res["status"] == "success":
        register_file_modification(path, "created/overwritten")
    return res

def tool_edit_file(args):
    path = args.get("path")
    target = args.get("target")
    replacement = args.get("replacement")
    if not path or target is None or replacement is None:
        return {"status": "error", "message": "Missing 'path', 'target', or 'replacement' arguments."}
        
    res = run_in_docker(["edit", "--path", path, "--target", target, "--replacement", replacement])
    if res["status"] == "success":
        register_file_modification(path, "edited")
    return res

def tool_grep_search(args):
    query = args.get("query")
    path = args.get("path", ".")
    if not query:
        return {"status": "error", "message": "Missing 'query' argument."}
    try:
        results = []
        if os.path.isfile(path):
            files = [path]
        else:
            files = []
            for root, dirs, filenames in os.walk(path):
                dirs[:] = [d for d in dirs if d not in {'vendor', 'node_modules', '.git', '.antigravity', '.locomo.agent'}]
                for f in filenames:
                    files.append(os.path.join(root, f))
        for f_path in files:
            try:
                with open(f_path, 'r', encoding='utf-8', errors='ignore') as f:
                    for line_no, line in enumerate(f, 1):
                        if query in line:
                            results.append({
                                "file": f_path,
                                "line": line_no,
                                "content": line.strip()
                            })
                            if len(results) >= 50:
                                break
            except Exception:
                pass
            if len(results) >= 50:
                break
        return {"status": "success", "results": results}
    except Exception as e:
        return {"status": "error", "message": str(e)}

def tool_list_dir(args):
    path = args.get("path", ".")
    try:
        entries = os.listdir(path)
        result = []
        for entry in entries:
            full = os.path.join(path, entry)
            result.append({
                "name": entry,
                "type": "directory" if os.path.isdir(full) else "file"
            })
        return {"status": "success", "entries": result}
    except Exception as e:
        return {"status": "error", "message": str(e)}

