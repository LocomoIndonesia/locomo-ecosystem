    p_config.add_argument("key", nargs="?", help="Kunci konfigurasi (lihat `config list`)")
    p_config.add_argument("value", nargs="?", help="Nilai baru (untuk aksi set)")

    # Command: status (Tiket 4.2, snapshot audit read-only)
