# Backup & rollback (Tiket 3.4): retensi 5 backup terbaru, restore via `rollback`.
BACKUP_RETENTION = 5

def _list_backups(anti_dir):
    parent = os.path.dirname(anti_dir)
    base = os.path.basename(anti_dir)
    cands = [os.path.join(parent, d) for d in os.listdir(parent)
             if d.startswith(base + ".backup-") and os.path.isdir(os.path.join(parent, d))]
    return sorted(cands)

def _prune_backups(anti_dir):
    backups = _list_backups(anti_dir)
    for old in backups[:-BACKUP_RETENTION]:
        shutil.rmtree(old)
        print(f"Backup lama dihapus (retensi {BACKUP_RETENTION}): {old}")

def cmd_rollback(args):
    anti_dir = resolve_os_dir(require=True)
    backups = _list_backups(anti_dir)
    if args.list:
        if not backups:
            print("Tidak ada backup tersedia.")
        for b in backups:
            print(b + (" (terbaru)" if b == backups[-1] else ""))
        return
    if not backups:
        print("Error: tidak ada backup untuk dikembalikan.")
        sys.exit(1)
    src = backups[-1]
    if not args.yes:
        print(f"Rollback akan mengganti {anti_dir} dengan backup terbaru:")
        print(f"  {src}")
        print("Ulangi dengan --yes untuk mengeksekusi. Instalasi saat ini dipindah ke .pre-rollback-<ts> sebagai pengaman.")
        sys.exit(0)
    aside = anti_dir + ".pre-rollback-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.move(anti_dir, aside)
    shutil.copytree(src, anti_dir, ignore=shutil.ignore_patterns("__pycache__"))
    print(f"Rollback selesai dari: {src}")
    print(f"Instalasi sebelumnya diamankan di: {aside}")

# State milik instalasi yang TIDAK BOLEH ditimpa upgrade (Fix-1): riwayat belajar
# dan graf hasil pindaian adalah data hidup project, bukan template.
PRESERVE_ON_UPGRADE = ["skills/runtime", "drivers/api/graphify-out"]

def _preserve_kind(rel, preserve):
    for p in preserve:
        if p == rel or rel.startswith(p + "/"):
            return "keep"      # tepat preserve leaf / di dalamnya: pertahankan utuh
        if p.startswith(rel + "/"):
            return "recurse"   # leluhur preserve: wajib turun ke dalam
    return "sync"

def _sync_tree(src, dst, preserve, protected, ignore_names, label):
    os.makedirs(dst, exist_ok=True)
    try:
        src_items = set(os.listdir(src))
    except FileNotFoundError:
        return
    for item in set(os.listdir(dst)) - src_items:
        r = f"{label}/{item}" if label else item
        if item == ".env" or any(p == r or r.startswith(p + "/") for p in protected):
            print(f"Protected (tidak disentuh): {r}")
            continue
        if _preserve_kind(r, preserve) in ("keep", "recurse"):
            continue
        full = os.path.join(dst, item)
        if os.path.isdir(full) and not os.path.islink(full):
            shutil.rmtree(full)
        else:
            os.remove(full)
    for item in src_items:
        if item in ignore_names or item.endswith(('.pyc', '.Zone.Identifier')):
            continue
        r = f"{label}/{item}" if label else item
        s, d = os.path.join(src, item), os.path.join(dst, item)
        kind = _preserve_kind(r, preserve)
        if kind == "keep":
            if not os.path.exists(d):
                if os.path.isdir(s) and not os.path.islink(s):
                    shutil.copytree(s, d)
                else:
                    shutil.copy2(s, d)
            else:
                print(f"Preserve (state instalasi): {r}")
            continue
        if kind == "recurse" and (os.path.isdir(s) and not os.path.islink(s)):
            if os.path.exists(d) and not os.path.isdir(d):
                os.remove(d)
            _sync_tree(s, os.path.join(dst, item), preserve, protected, ignore_names, r)
            continue
        if os.path.isdir(s) and not os.path.islink(s):
            if os.path.exists(d) and not os.path.isdir(d):
                os.remove(d)
            _sync_tree(s, os.path.join(dst, item), preserve, protected, ignore_names, r)
        else:
            shutil.copy2(s, d)

def _sync_managed_dir(src_d, dst_d, ignore_patterns):
    top = os.path.basename(dst_d)
    preserve = {p.split("/", 1)[1] for p in PRESERVE_ON_UPGRADE if p.split("/")[0] == top}
    # Fix-1 koreksi (M-2): file proteksi tak boleh dihapus sync-tepat —
    # PROTECTED_PATHS berelatif root OS + `.env` di level mana pun (secret lokal).
    protected = {p.split("/", 1)[1] for p in PROTECTED_PATHS if p.startswith(top + "/")}
    _sync_tree(src_d, dst_d, preserve, protected, {'.git', '__pycache__'}, "")

def _deep_add_missing(template, live):
    changed = False
    if isinstance(template, dict) and isinstance(live, dict):
        for k, v in template.items():
            if k not in live:
                live[k] = v
                changed = True
            elif _deep_add_missing(v, live[k]):
                changed = True
        return changed
    if isinstance(template, list) and isinstance(live, list):
        for i, tv in enumerate(template):
            if i < len(live) and _deep_add_missing(tv, live[i]):
                changed = True
        return changed
    return False

def _merge_state_schemas(anti_dir, master_dir):
    # Fix-1 lanjutan (M-2): file state yang di-preserve tetap mendapat FIELD BARU
    # dari template (aditif saja — nilai instalasi tidak pernah ditimpa).
    tpl_rt = os.path.join(master_dir, "skills", "runtime")
    dst_rt = os.path.join(anti_dir, "skills", "runtime")
    if not os.path.isdir(tpl_rt) or not os.path.isdir(dst_rt):
        return
    for fname in os.listdir(tpl_rt):
        if not fname.endswith(".json"):
            continue
        src, dst = os.path.join(tpl_rt, fname), os.path.join(dst_rt, fname)
        try:
            with open(src) as f:
                template = json.load(f)
            if not os.path.exists(dst):
                shutil.copy2(src, dst)
                print(f"Schema: {fname} disalin dari template (belum ada).")
                continue
            with open(dst) as f:
                live = json.load(f)
            if _deep_add_missing(template, live):
                with open(dst, "w") as f:
                    json.dump(live, f, indent=2)
                print(f"Schema: {fname} ditambah field baru dari template (nilai lama utuh).")
        except Exception as e:
            print(f"Schema: lewati {fname} ({e})")

def cmd_upgrade(args):
    anti_dir = resolve_os_dir(require=True)
    # Migrasi sekali-jalan dari nama lama (Amandemen A5) — wajib konfirmasi eksplisit.
    if os.path.basename(anti_dir) == LEGACY_OS_DIR_NAME:
        new_path = os.path.join(os.path.dirname(anti_dir), OS_DIR_NAME)
        if os.path.exists(new_path):
            print(f"Error: {LEGACY_OS_DIR_NAME} dan {OS_DIR_NAME} keduanya ada. Selesaikan manual sebelum upgrade.")
            sys.exit(1)
        print(f"Instalasi legacy terdeteksi: {anti_dir}")
        print(f"Upgrade akan memigrasi ke: {new_path}")
        confirm = input("Ketik YA untuk melanjutkan migrasi (selain itu dibatalkan): ").strip()
        if confirm != "YA":
            print("Upgrade dibatalkan. Tidak ada perubahan.")
            sys.exit(0)
        print(f"Migrasi {anti_dir} -> {new_path} ...")
        shutil.move(anti_dir, new_path)
        anti_dir = new_path

    master_dir = os.path.dirname(os.path.abspath(__file__))
    if not os.path.exists(os.path.join(master_dir, "skills")):
        for candidate in ("/app/locomo.agent", "/workspace/locomo.agent"):
            if os.path.exists(candidate):
                master_dir = candidate
                break
        else:
            print("Error: Master source template tidak ditemukan.")
            sys.exit(1)

    print(f"Upgrading Locomo Agent OS at {anti_dir} from master template...")
    print(f"PROTECTED (tidak disentuh): {PROTECTED_PATHS}")

    # Backup sebelum upgrade (Tiket 1.3) + retensi (Tiket 3.4)
    backup_dir = anti_dir + ".backup-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copytree(anti_dir, backup_dir, ignore=shutil.ignore_patterns("__pycache__"))
    print(f"Backup tersimpan di: {backup_dir}")
    _prune_backups(anti_dir)

    ignore_patterns = shutil.ignore_patterns('.git', '__pycache__', '*.pyc', '.Zone.Identifier')

    for d_name in MANAGED_DIRS:
        src_d = os.path.join(master_dir, d_name)
        dst_d = os.path.join(anti_dir, d_name)
        if os.path.realpath(src_d) == os.path.realpath(dst_d):
            print(f"Lewati {d_name}: master dan instalasi sama (cegah hapus diri).")
            continue
        _sync_managed_dir(src_d, dst_d, ignore_patterns)

    for f_name in MANAGED_FILES:
        src_f = os.path.join(master_dir, f_name)
        dst_f = os.path.join(anti_dir, f_name)
        shutil.copy2(src_f, dst_f)
        
    copied_locomo = os.path.join(anti_dir, "locomo")
    if os.path.exists(copied_locomo):
        os.chmod(copied_locomo, 0o755)
        
    # Also upgrade/create .agents folder in project root if it exists in master_dir
    proj_root = os.path.dirname(anti_dir)
    src_agents = os.path.join(master_dir, ".agents")
    dst_agents = os.path.join(proj_root, ".agents")
    if os.path.exists(src_agents):
        shutil.copytree(src_agents, dst_agents, ignore=ignore_patterns, dirs_exist_ok=True)

    # Merge skema state (M-2): file preserve mendapat field baru template.
    _merge_state_schemas(anti_dir, master_dir)

    # Validasi pasca-upgrade (Tiket 3.4): cortex rusak = rollback otomatis.
    errors, warnings = validate_cortex(anti_dir)
    for w in warnings:
        print(f"[UPGRADE] PERINGATAN: {w}")
    if errors:
        print("[UPGRADE] Cortex hasil upgrade RUSAK — rollback otomatis ke backup:")
        for e in errors:
            print(f"  - {e}")
        aside = anti_dir + ".pre-rollback-" + datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        shutil.move(anti_dir, aside)
        shutil.copytree(backup_dir, anti_dir, ignore=shutil.ignore_patterns("__pycache__"))
        print(f"Rollback otomatis selesai. Hasil upgrade gagal diamankan di: {aside}")
        sys.exit(1)

    print("Locomo Agent OS successfully upgraded to the latest master version!")

