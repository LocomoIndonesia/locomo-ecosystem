        # Fallback to current working directory name
        return os.path.basename(os.getcwd())
    try:
        with open(os.path.join(anti_dir, "id.json"), 'r') as f:
            cfg = json.load(f)
            return cfg.get("project_name", os.path.basename(os.getcwd()))
    except Exception:
        return os.path.basename(os.getcwd())

def register_file_modification(path, action):
    MODIFICATIONS.append({
        "file": path,
        "action": action,
        "timestamp": datetime.datetime.now().isoformat()
    })

def run_in_docker(args_list):
    anti_dir = resolve_os_dir(require=False)
    if not anti_dir:
        return {"status": "error", "message": f"Folder {OS_DIR_NAME} tidak ditemukan."}
    drivers_dir = os.path.join(anti_dir, "drivers")
    # If container is not running, we print a warning and run via shell/docker compose
    cmd = ["docker", "compose", "exec", "-T", "semantic-api", "python3", "/app/docker_agent_editor.py"] + args_list
    try:
        ret = subprocess.run(cmd, cwd=drivers_dir, capture_output=True, text=True)
        if ret.returncode == 0:
            return {"status": "success", "message": ret.stdout.strip()}
        else:
            return {"status": "error", "message": ret.stderr.strip() or ret.stdout.strip()}
    except Exception as e:
        return {"status": "error", "message": f"Failed to execute command in Docker container: {e}"}

