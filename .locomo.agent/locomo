def load_env_variables():
    env_path = os.path.abspath(".env")
    if os.path.exists(env_path):
        try:
            with open(env_path, 'r', encoding='utf-8') as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith('#') and '=' in line:
                        k, v = line.split('=', 1)
                        os.environ[k.strip()] = v.strip().strip('"').strip("'")
        except Exception:
            pass

def map_to_gemini(history):
    contents = []
    system_instruction = None
    for msg in history:
        role = msg["role"]
        content = msg["content"]
        if role == "system":
            system_instruction = {"parts": [{"text": content}]}
        else:
            mapped_role = "model" if role in ("assistant", "model") else "user"
            contents.append({
                "role": mapped_role,
                "parts": [{"text": content}]
            })
    return contents, system_instruction

def call_gemini_api(api_key, model_name, history):
    contents, system_instruction = map_to_gemini(history)
    payload = {
        "contents": contents,
        "generationConfig": {
            "temperature": 0.2
        }
    }
    if system_instruction:
        payload["systemInstruction"] = system_instruction
        
    url = f"https://generativelanguage.googleapis.com/v1beta/models/{model_name}:generateContent?key={api_key}"
    req = urllib.request.Request(url, method='POST')
    req.add_header('Content-Type', 'application/json')
    try:
        payload_data = json.dumps(payload).encode('utf-8')
        with urllib.request.urlopen(req, data=payload_data) as response:
            res_body = response.read().decode('utf-8')
            res_json = json.loads(res_body)
            text = res_json["candidates"][0]["content"]["parts"][0]["text"]
            return {"role": "assistant", "content": text}
    except Exception as e:
        print(f"Error calling Gemini API: {e}")
        return None

def cmd_think(args):
    load_env_variables()
    prompt = args.prompt
    model = args.model
    provider = args.provider
    gemini_model = args.gemini_model
    
    gemini_api_key = os.environ.get("GEMINI_API_KEY")
    # If GEMINI_MODEL is set in .env, prioritize it over default
    if os.environ.get("GEMINI_MODEL"):
        gemini_model = os.environ.get("GEMINI_MODEL")
        
    if provider == "gemini" and not gemini_api_key:
        print("Error: Perintah menggunakan provider 'gemini' tetapi GEMINI_API_KEY tidak ditemukan di environment atau berkas .env.")
        sys.exit(1)
        
    # Setup Ollama model tags if local is needed
    available_models = []
    if provider == "local" or not gemini_api_key:
        url = f"{OLLAMA_URL}/api/tags"
        req = urllib.request.Request(url)
        try:
            with urllib.request.urlopen(req) as res:
                tags = json.loads(res.read().decode('utf-8'))
                available_models = [m["name"] for m in tags.get("models", [])]
        except Exception:
            pass
            
        if not available_models and provider == "local":
            print("Warning: Gagal terhubung ke Ollama lokal.")
            if gemini_api_key:
                print("[AUTO-ROUTING] Mengalihkan ke Gemini API karena Ollama tidak dapat dihubungi...")
                provider = "gemini"
            else:
                print("Error: Tidak ada model lokal tersedia dan GEMINI_API_KEY tidak dikonfigurasi.")
                sys.exit(1)
        elif model not in available_models and provider == "local":
            qwen_models = [m for m in available_models if "qwen" in m]
            if qwen_models:
                model = qwen_models[0]
            elif available_models:
                model = available_models[0]

    print(f"Active Task: {prompt}")
    print(f"Initial reasoning provider: {provider.upper()}")
    if provider == "gemini":
        print(f"Using Cloud model: {gemini_model}")
    else:
        print(f"Using Local model: {model}")
    print("Initializing Reasoning Loop...")
    
    project_code = get_project_code()
    tech_stack = "General"
    id_path = os.path.join(resolve_os_dir(require=False) or ".", "id.json")
    if os.path.exists(id_path):
        try:
            with open(id_path, 'r') as f:
                cfg = json.load(f)
                tech_stack = json.dumps(cfg.get("tech_stack", {}))
        except Exception:
            pass
            
    system_prompt = f"""You are the local offline reasoning agent of Locomo Agent OS V2.0.
Your active project is: {project_code}
Your active tech stack: {tech_stack}

Your task is: {prompt}

You have access to the following tools:
1. read_file: Read file content in the project.
   Args: {{"path": "<relative_path>"}}
2. write_file: Create a new file or overwrite an existing file.
   Args: {{"path": "<relative_path>", "content": "<file_content>"}}
3. edit_file: Replace a specific block of text in a file.
   Args: {{"path": "<relative_path>", "target": "<exact_text_to_replace>", "replacement": "<new_text>"}}
4. grep_search: Search for a query inside files in the project.
   Args: {{"query": "<text>", "path": "<relative_path>"}}
5. list_dir: List files in a directory.
   Args: {{"path": "<relative_path>"}}
6. store_memory: Store a cognitive memory block in pgvector database.
   Args: {{"content": "<text>", "type": "<type>", "metadata": {{}}}}
7. query_memory: Retrieve matching cognitive memories from pgvector.
   Args: {{"query": "<search_term>"}}
8. log_decision: Write a log entry to cortex/decisions.jsonl.
   Args: {{"task_id": "LOCAL_THINK", "phase": "ACT", "hypothesis": "<details>", "result": "success"}}

To use a tool, you MUST output a single JSON block representing the tool call, like this:
{{
  "tool": "read_file",
  "args": {{"path": "src/App.vue"}}
}}

Wait for the system response. Do not output anything else in the same message when you call a tool.
If you have completed your task, or if you cannot complete it, output your final response in this JSON format:
{{
  "final_response": "Your detailed summary of actions and results."
}}
"""

    history = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": f"Task: {prompt}\nPlease start by planning and using any tools necessary."}
    ]
    
    max_steps = 15
    step = 0
    
    while step < max_steps:
        step += 1
        print(f"\n--- Reasoning Step {step}/{max_steps} ---")
        
        # Calculate Context Tokens size (approximated)
        approx_tokens = sum(len(m["content"]) for m in history) // 4
        print(f"Current Context Size: ~{approx_tokens} tokens")
        
        # Auto-routing fallback check
        if approx_tokens > 4096 and provider == "local":
            if gemini_api_key:
                print(f"[AUTO-ROUTING] Konteks saat ini (~{approx_tokens} token) melebihi batas 4.096 token.")
                print(f"Mengalihkan otomatis ke Google Gemini API ({gemini_model}) untuk penanganan optimal...")
                provider = "gemini"
            else:
                print(f"[WARNING] Konteks saat ini (~{approx_tokens} token) melebihi kapasitas optimal lokal (4.096 token). Performa dapat menurun.")
        
        response_text = None
        
        if provider == "gemini":
            res_msg = call_gemini_api(gemini_api_key, gemini_model, history)
            if res_msg:
                response_text = res_msg["content"]
                model_message = res_msg
            else:
                print("Error: Gemini API call failed.")
                break
        else:
            req_payload = {
                "model": model,
                "messages": history,
                "stream": False,
                "options": {
                    "temperature": 0.2
                }
            }
            req = urllib.request.Request(f"{OLLAMA_URL}/api/chat", method='POST')
            req.add_header('Content-Type', 'application/json')
            try:
                payload_data = json.dumps(req_payload).encode('utf-8')
                with urllib.request.urlopen(req, data=payload_data) as response:
                    res_body = response.read().decode('utf-8')
                    res_json = json.loads(res_body)
                    model_message = res_json["message"]
                    response_text = model_message["content"]
            except Exception as e:
                print(f"Error calling Ollama API: {e}")
                break
                
        print(f"Agent response:\n{response_text}")
        history.append(model_message)
        
        tool_call = None
        final_response = None
        
        parsed_json = None
        start_indices = [m.start() for m in re.finditer(r'\{', response_text)]
        for start in start_indices:
            stack = 0
            for i in range(start, len(response_text)):
                if response_text[i] == '{':
                    stack += 1
                elif response_text[i] == '}':
                    stack -= 1
                    if stack == 0:
                        candidate = response_text[start:i+1]
                        try:
                            parsed_json = json.loads(candidate)
                            break
                        except Exception:
                            pass
            if parsed_json:
                break
                
        if parsed_json:
            if "tool" in parsed_json and "args" in parsed_json:
                tool_call = parsed_json
            elif "final_response" in parsed_json:
                final_response = parsed_json["final_response"]
                
        if final_response:
            print(f"\n[FINAL RESPONSE]\n{final_response}")
            log_decision_to_file("LOCAL_THINK", "REFLECT", prompt, "success")
            break
            
        if tool_call:
            tool_name = tool_call["tool"]
            tool_args = tool_call["args"]
            print(f"\n[TOOL CALL] Executing tool: '{tool_name}' with args: {tool_args}")
            
            tool_fn = TOOLS.get(tool_name)
            if tool_fn:
                tool_result = tool_fn(tool_args)
            else:
                tool_result = {"status": "error", "message": f"Unknown tool '{tool_name}'."}
                
            print(f"[TOOL RESULT] {json.dumps(tool_result)}")
            
            history.append({
                "role": "user",
                "content": json.dumps(tool_result)
            })
        else:
            warning_msg = "Please output a valid tool call JSON or a final_response JSON. Do not output plain text."
            print(f"\n[WARNING] {warning_msg}")
            history.append({
                "role": "user",
                "content": warning_msg
            })
            
    if MODIFICATIONS:
        print(f"\nAuto-updating change logs & project context... ({len(MODIFICATIONS)} modifications detected)")
        write_automatic_changelog(prompt)

