# Standar signature file (Amandemen A3, format kanonis v10.2.0-master).
SIGNATURE_TEMPLATE = "{comment_open} File generated by {tool}, and Orchestrated by Ronald Poetra (Zaid) last updated at {timestamp} {comment_close}"

def signature_header(tool, language="generic"):
    styles = {
        "python": ("#", ""), "shell": ("#", ""), "sql": ("--", ""),
        "php": ("/*", "*/"), "js": ("/*", "*/"), "generic": ("/*", "*/"),
        "html": ("<!--", "-->"), "markdown": ("<!--", "-->"),
    }
    comment_open, comment_close = styles.get(language, styles["generic"])
    return SIGNATURE_TEMPLATE.format(
        comment_open=comment_open, comment_close=comment_close,
        tool=tool,
        timestamp=datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    )

def resolve_os_dir(require=True):
    """Kembalikan path folder OS aktif: kanonis dulu, legacy bila ada (dengan peringatan)."""
    for name in (OS_DIR_NAME, LEGACY_OS_DIR_NAME):
        candidate = os.path.abspath(name)
        if os.path.exists(candidate) and os.path.isdir(candidate):
            if name == LEGACY_OS_DIR_NAME:
                print(f"Peringatan: berjalan dari folder legacy {LEGACY_OS_DIR_NAME}; jalankan upgrade untuk migrasi ke {OS_DIR_NAME}.", file=sys.stderr)
            return candidate
    if os.path.basename(os.getcwd()) in (OS_DIR_NAME, LEGACY_OS_DIR_NAME):
        if os.path.basename(os.getcwd()) == LEGACY_OS_DIR_NAME:
            print(f"Peringatan: berjalan dari folder legacy {LEGACY_OS_DIR_NAME}; jalankan upgrade untuk migrasi ke {OS_DIR_NAME}.", file=sys.stderr)
        return os.getcwd()
    if require:
        print(f"Error: Folder {OS_DIR_NAME} tidak ditemukan. Jalankan perintah ini dari project root.")
        sys.exit(1)
    return None

def detect_agent_tools(root):
    """Deteksi tools agent yang dipakai developer (Amandemen A2)."""
    markers = {
        "antigravity": [".antigravity"],
        "cursor": [".cursor", ".cursorrules"],
        "codex": [".codex"],
        "opencode": [".opencode", "opencode.json"],
        "openclaw": [".openclaw"],
        "gemini": ["GEMINI.md", ".gemini"],
        "copilot": [".github"],
        "vscode": [".vscode"],
    }
    try:
        entries = set(os.listdir(root))
    except Exception:
        entries = set()
    found = set()
    for tool, names in markers.items():
        if any(n in entries for n in names):
            found.add(tool)
    return found

# Helper Utility untuk HTTP POST request menggunakan library standar
def http_post(url, data):
    req = urllib.request.Request(url, method='POST')
    req.add_header('Content-Type', 'application/json')
    try:
        payload = json.dumps(data).encode('utf-8')
        with urllib.request.urlopen(req, data=payload) as response:
            res_body = response.read().decode('utf-8')
            return json.loads(res_body)
    except urllib.error.URLError as e:
        print(f"API Error: Gagal terhubung ke {url}. Alasan: {e}")
        return None
    except Exception as e:
        print(f"API Error: {e}")
        return None

def get_project_code():
