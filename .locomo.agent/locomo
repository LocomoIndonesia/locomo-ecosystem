def cmd_bootcheck(args):
    """Kontrak boot memori (Tiket 1.4): verifikasi driver + registrasi project + kesegaran graf."""
    anti_dir = resolve_os_dir(require=True)
    ctx_path = os.path.join(anti_dir, "docs", "project-context.json")
    try:
        with open(ctx_path, "r", encoding="utf-8") as f:
            ctx = json.load(f)
        project_code = ctx.get("active_project", "")
    except Exception as e:
        print(f"[BOOTCHECK] Gagal membaca project-context.json: {e}")
        sys.exit(1)
    if not project_code:
        print("[BOOTCHECK] active_project kosong — jalankan `locomo select <project>` dulu.")
        sys.exit(1)
    print(f"[BOOTCHECK] Active project: {project_code}")

    # 1. Liveness + registrasi via query (read-only, tanpa Auth — lihat Tiket 0.2 deferred)
    res = http_post(f"{API_URL}/memory/query", {"project_code": project_code, "query": "bootcheck", "top_k": 1})
    if res is None:
        print("[BOOTCHECK] DRIVERLESS — semantic-api tidak merespons. Jalankan: cd <os>/drivers && docker compose up -d")
        sys.exit(1)
    rows = res.get("data", []) if isinstance(res, dict) else []
    if rows:
        print("[BOOTCHECK] Project TERDAFTAR di pgvector (memori ditemukan).")
    else:
        print("[BOOTCHECK] Project BELUM terdaftar (query kosong).")
        if args.yes:
            init_res = http_post(f"{API_URL}/project/init", {"project_code": project_code, "project_name": f"{project_code.upper()} Project"})
            if init_res:
                print("[BOOTCHECK] Registrasi init OK. Lanjut: `locomo graphify` untuk pemindaian awal.")
            else:
                print("[BOOTCHECK] Registrasi gagal — pastikan drivers berjalan.")
                sys.exit(1)
        else:
            print("[BOOTCHECK] Remediasi: `locomo bootcheck --yes` (daftar + panduan graphify) atau `locomo select <project>`.")
            sys.exit(1)

    # 2. Kesegaran graf graphify
    graph_path = os.path.join(anti_dir, "drivers", "api", "graphify-out", "graph.json")
    if os.path.exists(graph_path):
        age_h = (datetime.datetime.now().timestamp() - os.path.getmtime(graph_path)) / 3600
        print(f"[BOOTCHECK] Graf graphify-out/graph.json umur {age_h:.1f} jam.")
        if age_h > 24:
            print("[BOOTCHECK] Graf basi (>24 jam) — jalankan `locomo graphify`.")
    else:
        print("[BOOTCHECK] Graf belum ada — jalankan `locomo graphify`.")

    # 3. Validasi skema cortex (Tiket 1.3, diperluas 2.4)
    errors, warnings = validate_cortex(anti_dir)
    for w in warnings:
        print(f"[BOOTCHECK] PERINGATAN: {w}")
    if errors:
        for e in errors:
            print(f"[BOOTCHECK] ERROR: {e}")
        sys.exit(1)
    print("[BOOTCHECK] Cortex valid." + (f" ({len(warnings)} peringatan)" if warnings else ""))
    print("[BOOTCHECK] OK.")

def cmd_init(args):
    target = os.path.abspath(args.target_dir)
    print(f"Initializing Locomo Agent OS at: {target}")
    
    os.makedirs(target, exist_ok=True)
    
    anti_dir = os.path.join(target, OS_DIR_NAME)
    legacy_dir = os.path.join(target, LEGACY_OS_DIR_NAME)
    if os.path.exists(legacy_dir) and not os.path.exists(anti_dir):
        print(f"Instalasi lama terdeteksi di {legacy_dir}. Gunakan perintah upgrade untuk migrasi ke {OS_DIR_NAME}.")
        sys.exit(1)
    if os.path.exists(anti_dir):
        print(f"Error: {OS_DIR_NAME} folder already exists at {target}. Use upgrade command instead.")
        sys.exit(1)
        
    source_dir = os.path.dirname(os.path.abspath(__file__))
    os.makedirs(anti_dir)
    print("Copying core template files...")
    
    ignore_patterns = shutil.ignore_patterns('.git', '__pycache__', '*.pyc', '.Zone.Identifier', '.env')
    
    for item in os.listdir(source_dir):
        s = os.path.join(source_dir, item)
        d = os.path.join(anti_dir, item)
        if os.path.isdir(s):
            shutil.copytree(s, d, ignore=ignore_patterns)
        else:
            shutil.copy2(s, d)
            
    copied_locomo = os.path.join(anti_dir, "locomo")
    if os.path.exists(copied_locomo):
        os.chmod(copied_locomo, 0o755)
        
    # Initialize .agents folder
    agents_dir = os.path.join(target, ".agents")
    os.makedirs(agents_dir, exist_ok=True)
