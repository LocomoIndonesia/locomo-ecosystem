# Helper Utility untuk HTTP POST request menggunakan library standar
def http_post(url, data):
    req = urllib.request.Request(url, method='POST')
    req.add_header('Content-Type', 'application/json')
    try:
        payload = json.dumps(data).encode('utf-8')
        with urllib.request.urlopen(req, data=payload) as response:
            res_body = response.read().decode('utf-8')
            return json.loads(res_body)
    except urllib.error.URLError as e:
        print(f"API Error: Gagal terhubung ke {url}. Alasan: {e}")
        return None
    except Exception as e:
        print(f"API Error: {e}")
        return None

def get_project_code():
    anti_dir = os.path.abspath(".antigravity")
    if not os.path.exists(anti_dir):
        # Fallback to current working directory name
        return os.path.basename(os.getcwd())
    try:
        with open(os.path.join(anti_dir, "id.json"), 'r') as f:
            cfg = json.load(f)
            return cfg.get("project_name", os.path.basename(os.getcwd()))
    except Exception:
        return os.path.basename(os.getcwd())

def register_file_modification(path, action):
    MODIFICATIONS.append({
        "file": path,
        "action": action,
        "timestamp": datetime.datetime.now().isoformat()
    })

def run_in_docker(args_list):
    anti_dir = os.path.abspath(".antigravity")
    drivers_dir = os.path.join(anti_dir, "drivers")
    # If container is not running, we print a warning and run via shell/docker compose
    cmd = ["docker", "compose", "exec", "-T", "semantic-api", "python3", "/app/docker_agent_editor.py"] + args_list
    try:
        ret = subprocess.run(cmd, cwd=drivers_dir, capture_output=True, text=True)
        if ret.returncode == 0:
            return {"status": "success", "message": ret.stdout.strip()}
        else:
            return {"status": "error", "message": ret.stderr.strip() or ret.stdout.strip()}
    except Exception as e:
        return {"status": "error", "message": f"Failed to execute command in Docker container: {e}"}

def log_decision_to_file(task_id, phase, hypothesis, result):
    res = run_in_docker([
        "log_decision", 
        "--task_id", task_id, 
        "--phase", phase, 
        "--hypothesis", hypothesis, 
        "--result", result
    ])
    if res["status"] != "success":
        print(f"Warning: Gagal menulis log keputusan via Docker: {res['message']}")

def write_automatic_changelog(prompt):
    if not MODIFICATIONS:
        return
    mods_json = json.dumps(MODIFICATIONS)
    res = run_in_docker([
