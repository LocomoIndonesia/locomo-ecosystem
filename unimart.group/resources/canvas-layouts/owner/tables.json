{
  "screen": "tables",
  "title": "Meja & QR Code",
  "data_api": "/canvas/api/tables",
  "widgets": [
    {
      "id": "tables_summary",
      "type": "stat_row",
      "data_key": "summary",
      "stats": [
        { "key": "total",     "label": "Total Meja",  "icon": "🪑" },
        { "key": "available", "label": "Tersedia",    "icon": "🟢" },
        { "key": "occupied",  "label": "Terisi",      "icon": "🔴" }
      ]
    },
    {
      "id": "table_grid",
      "type": "table_status_grid",
      "data_key": "tables",
      "columns": 3,
      "tap_action": "open_sheet:table_detail"
    }
  ],
  "sheets": {
    "table_detail": {
      "title": "Detail Meja",
      "widgets": [
        { "type": "table_info" },
        { "type": "qr_code_display", "label": "QR Pemesanan", "download": true, "share": true },
        { "type": "active_order_info", "show_when": "has_active_order" }
      ]
    }
  }
}
