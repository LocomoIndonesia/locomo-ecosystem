{
  "screen": "menu",
  "title": "Kelola Menu",
  "data_api": "/canvas/api/menu",
  "widgets": [
    {
      "id": "menu_searchbar",
      "type": "search_input",
      "placeholder": "Cari nama menu..."
    },
    {
      "id": "category_filter",
      "type": "filter_chips",
      "data_source": "categories",
      "all_label": "Semua Kategori"
    },
    {
      "id": "menu_list",
      "type": "menu_card_list",
      "data_key": "products",
      "tap_action": "open_sheet:edit_menu",
      "show_stock": true,
      "show_availability_toggle": true,
      "toggle_api": "POST:/canvas/api/menu/{id}/toggle"
    }
  ],
  "fab": {
    "icon": "+",
    "label": "Tambah Menu",
    "action": "open_sheet:add_menu"
  },
  "sheets": {
    "add_menu":  { "title": "Tambah Menu Baru",   "type": "menu_form", "mode": "add",  "api": "POST:/canvas/api/menu/save" },
    "edit_menu": { "title": "Edit Menu",           "type": "menu_form", "mode": "edit", "api": "POST:/canvas/api/menu/save" }
  }
}
