{
  "screen": "orders",
  "title": "Pesanan",
  "data_api": "/canvas/api/orders",
  "poll_interval_ms": 5000,
  "widgets": [
    {
      "id": "status_filters",
      "type": "filter_chips",
      "options": [
        { "value": "all",      "label": "Semua" },
        { "value": "pending",  "label": "Pending",   "badge_key": "pending" },
        { "value": "preparing","label": "Diproses",  "badge_key": "preparing" },
        { "value": "ready",    "label": "Siap",      "badge_key": "ready" },
        { "value": "served",   "label": "Diantar" }
      ],
      "filter_param": "status",
      "default": "all"
    },
    {
      "id": "orders_list",
      "type": "order_card_list",
      "data_key": "orders",
      "swipe_actions": [
        { "direction": "right", "action": "prepare",  "label": "Proses",  "color": "#3B82F6", "icon": "🔵" },
        { "direction": "left",  "action": "cancel",   "label": "Batal",   "color": "#EF4444", "icon": "❌" }
      ],
      "tap_action": "open_sheet:order_detail",
      "show_timer": true,
      "show_table": true,
      "new_item_badge": true
    }
  ],
  "sheets": {
    "order_detail": {
      "title": "Detail Pesanan",
      "widgets": [
        { "type": "order_info_header" },
        { "type": "order_item_list", "show_note": true },
        { "type": "order_total" },
        { "type": "order_action_buttons",
          "actions": ["prepare","deliver","complete","cancel"],
          "api": "POST:/canvas/api/orders/{id}/action" }
      ]
    }
  }
}
